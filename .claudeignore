# Kept in sync with .cursorignore — update both when policy changes.

# Build artifacts & caches
node_modules/
dist/
build/
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
*.egg-info/
.eslintcache
*.tsbuildinfo
.ipynb_checkpoints/

# Test & coverage output
coverage.xml
coverage/
htmlcov/
.coverage
playwright-report*/
test-results/
.playwright-mcp/
.flaitron/screenshots/

# Logs
*.log

# Lock files — large, derivable from manifest; uncomment to exclude from indexing
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# poetry.lock

# OS / editor noise
.DS_Store
*.suo
*.sw?

# Personal scratch
SCRATCHPAD.md

# Secrets — configs/.gitignore's .env*/.dev.vars lines plus *.pem; the two examples stay indexed, as the hook spares them (docs/SECRETS.md, NAT-466.3, NAT-466.5)
.env*
!.env.example
.dev.vars*
!.dev.vars.example
*.pem

# Flaitron dogfood archive — tracked submodule content; .gitignore cannot exclude it.
.flaitron/core/.flaitron/
